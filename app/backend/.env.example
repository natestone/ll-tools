# ---------------------------------------------------------------------------
# League Manager — environment
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Both `npm start` and PM2 read this file via node --env-file.
# ---------------------------------------------------------------------------

# ---- database -------------------------------------------------------------
# The app user needs SELECT/INSERT/UPDATE/DELETE plus DDL (CREATE/ALTER/DROP,
# INDEX, REFERENCES) because `prisma migrate deploy` runs schema changes on
# every release. Reserve CREATE DATABASE for the one-time setup instead.
# Special characters in the password must be percent-encoded.
DATABASE_URL="mysql://ll_manager:CHANGE_ME@127.0.0.1:3306/ll_manager"

# ---- http -----------------------------------------------------------------
PORT=3001

# Public origin of the site, no trailing slash. Used to build the links that go
# into emails (password resets, invites, ballots) — get it wrong and every
# emailed link points at the wrong host.
APP_URL="https://ll-manager.org"

# Only needed when the front end is served from a DIFFERENT origin than the API
# (i.e. a separate Vite dev server). In production this process serves the built
# client itself, so leave it as the production origin.
CLIENT_ORIGIN="https://ll-manager.org"

# Set to 1 in production. Marks the session cookie Secure so it is never sent
# over plain http. Leave unset for local http development or you cannot log in.
COOKIE_SECURE=1

# ---- secrets --------------------------------------------------------------
# Generate fresh values per environment:  openssl rand -base64 48
# Changing SESSION_SECRET signs everyone out. Changing MAIL_SECRET invalidates
# every unsubscribe link already sitting in people's inboxes.
SESSION_SECRET="CHANGE_ME"
MAIL_SECRET="CHANGE_ME"

# ---- email ----------------------------------------------------------------
# console = print messages to the log and send nothing (safe default)
# smtp    = real delivery, e.g. Amazon SES
MAIL_DRIVER=smtp

# Must be an address on a domain verified in SES, or delivery is rejected.
MAIL_FROM="G·NG·R Little League <no-reply@ll-manager.org>"
MAIL_REPLY_TO="board@ll-manager.org"
MAIL_BRAND="League Manager"

# SES SMTP endpoint for your region. Port 587 is STARTTLS.
# These are SES *SMTP* credentials — generated in the SES console — and are NOT
# your AWS access key pair. See docs/DEPLOYMENT.md §5.
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT=587
SMTP_USER="CHANGE_ME"
SMTP_PASS="CHANGE_ME"

# ---- optional -------------------------------------------------------------
# Where the built front end lives. Defaults to ../../frontend/dist, which is
# correct for a standard checkout; set it only if you relocate the build.
#CLIENT_DIR="/srv/ll-manager/app/frontend/dist"

# Only if the API is ever hosted somewhere other than APP_URL. It builds the
# one-click List-Unsubscribe URL that mail clients POST to server-side; it
# falls back to APP_URL, which is correct for a single-origin deployment.
#API_URL="https://api.ll-manager.org"
