{
  "name": "gngrll-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "db:setup": "npm --workspace backend run migrate && npm --workspace backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
